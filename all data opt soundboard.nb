Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"sounddata", "=", 
   RowBox[{
    RowBox[{
    "Import", "[", 
     "\"\<C:\\\\Users\\\\akrem\\\\Desktop\\\\work\\\\soundboard\\\\soundboard_\
data.xlsx\>\"", "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"traininput", "=", 
   RowBox[{"sounddata", "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"2", ";;"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"trainout", "=", 
   RowBox[{"sounddata", "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"2", ";;"}], ",", "4"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"train", "=", 
    RowBox[{"Thread", "[", 
     RowBox[{"Rule", "[", 
      RowBox[{"traininput", ",", "trainout"}], "]"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"predictor", "=", 
    RowBox[{"Predict", "[", 
     RowBox[{"train", ",", 
      RowBox[{"Method", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<GaussianProcess\>\"", ",", 
         RowBox[{"\"\<CovarianceType\>\"", "->", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Numerical\>\"", "->", "\"\<SquaredExponential\>\""}],
             ",", 
            RowBox[{"\"\<Nominal\>\"", "->", "\"\<HammingDistance\>\""}]}], 
           "|>"}]}], ",", 
         RowBox[{
         "\"\<EstimationMethod\>\"", "->", "\"\<MaximumLikelihood\>\""}]}], 
        "}"}]}], ",", 
      RowBox[{"PerformanceGoal", "->", "\"\<Quality\>\""}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "domain"}]}], " ", "of", " ", 
     RowBox[{"data", "--"}]}], "-"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"sbThicknessRange", "=", 
   RowBox[{"MinMax", "[", 
    RowBox[{"traininput", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"barThicknessRange", "=", 
   RowBox[{"MinMax", "[", 
    RowBox[{"traininput", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bracingTypes", "=", 
    RowBox[{"Union", "[", 
     RowBox[{"traininput", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "3"}], "]"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "objectif"}]}], " ", 
     RowBox[{"funct", "--"}]}], "-"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"objectiveSPL", "[", "config_", "]"}], ":=", 
    RowBox[{"predictor", "[", "config", "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "mixed"}]}], " ", "cinfig", " ", "generator", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"numeric", "+", "nominal"}], ")"}], "--"}]}], "-"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"configSampler", "[", "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"RandomReal", "[", "sbThicknessRange", "]"}], ",", 
      RowBox[{"RandomReal", "[", "barThicknessRange", "]"}], ",", 
      RowBox[{"RandomChoice", "[", "bracingTypes", "]"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "Optimisation"}]}], " ", 
     RowBox[{"bay\[EAcute]sienne", "--"}]}], "-"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"boSPL", "=", 
    RowBox[{"BayesianMaximization", "[", 
     RowBox[{"objectiveSPL", ",", "configSampler", ",", 
      RowBox[{"Method", "->", "\"\<MaxExpectedImprovement\>\""}], ",", 
      RowBox[{"MaxIterations", "->", "40"}]}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"-", 
      RowBox[{"Resuls", "--"}]}]}], "-"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bestConfig", "=", 
   RowBox[{"boSPL", "[", "\"\<MaximumConfiguration\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bestSPL", "=", 
    RowBox[{"boSPL", "[", "\"\<MaximumValue\>\"", "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<best config found :\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  doundboard thickness : \>\"", ",", 
    RowBox[{"bestConfig", "[", 
     RowBox[{"[", "1", "]"}], "]"}], ",", "\"\< mm\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  bar thickness : \>\"", ",", 
    RowBox[{"bestConfig", "[", 
     RowBox[{"[", "2", "]"}], "]"}], ",", "\"\< mm\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  bracing type : \>\"", ",", 
    RowBox[{"bestConfig", "[", 
     RowBox[{"[", "3", "]"}], "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\< max predicted SPL : \>\"", ",", "bestSPL"}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Visualisation", " ", "of", " ", "convergence"}], "*)"}]}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{"boSPL", "[", "\"\<EvaluationHistory\>\"", "]"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "\"\<Value\>\""}], "]"}], "]"}], ",", 
   RowBox[{
   "PlotLabel", "->", "\"\<Convergence of SPL within iterations\>\""}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Iterations\>\"", ",", "\"\< predicted SPL\>\""}], "}"}]}]}],
   "]"}]}], "Input",
